# crop.health (Kindwise) - the recommended provider. Key: https://admin.kindwise.com
# Set it and AgroLens uses the live model; leave it blank for the offline mock classifier.
CROP_HEALTH_API_KEY=
# Optional overrides
CROP_HEALTH_API_URL=
CROP_HEALTH_LANGUAGE=en

# Generic label/score endpoint - only used when CROP_HEALTH_API_KEY is blank
VISION_API_URL=
VISION_API_KEY=
