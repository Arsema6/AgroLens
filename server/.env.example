PORT=8787

# Kindwise keys are issued per service, so set the one your key belongs to.
# Keys: https://admin.kindwise.com - leave both blank for the offline mock classifier.

# crop.health - the recommended provider: crop-specific, and also names the crop
CROP_HEALTH_API_KEY=
# plant.id - wider plant health model, no crop name
PLANT_ID_API_KEY=

# Optional overrides
CROP_HEALTH_API_URL=
PLANT_ID_API_URL=
KINDWISE_LANGUAGE=en

# Generic label/score endpoint - only used when both Kindwise keys are blank
VISION_API_URL=
VISION_API_KEY=
